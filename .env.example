ADMIN_DATABASE_URL=postgresql://admin:CHANGE_ME@127.0.0.1:55434/saas_admin
ADMIN_AUTH_URL=http://127.0.0.1:59000
ADMIN_ALLOW_LOCAL_HTTP=true
# Generate a 32-byte base64url credential; share only with Portal BFF.
ADMIN_PORTAL_KEY=
PORT=59100
HOST=127.0.0.1
# Operator CLI only, never set on web process:
# ADMIN_ENABLE_OPERATOR=true
# ADMIN_OPERATOR_ID=operator:name
# Explicit operator-approved deployment origins; no wildcards.
ADMIN_ALLOWED_APP_ORIGINS=https://reports.internal.example
# Runtime registry operator policy: strict subdomains, HTTPS port 443 only.
# Keep this aligned with Portal's independent infrastructure policy.
ADMIN_APP_DNS_SUFFIXES=apps.internal.example
