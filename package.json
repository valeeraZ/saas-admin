{
  "name": "saas-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "start": "node src/server.ts",
    "db:migrate": "node src/cli.ts migrate",
    "catalog:apply": "node src/cli.ts apply",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "contracts": "node scripts/contracts.ts",
    "test:integration": "node --env-file=.env.local integration/catalog.test.ts",
    "format:check": "prettier --check src tests scripts integration/catalog.test.ts"
  },
  "dependencies": {
    "pg": "8.23.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  }
}
