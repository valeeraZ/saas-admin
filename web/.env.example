# Database account dedicated to the operator console; do not reuse the read-only API account.
ADMIN_DATABASE_URL=postgresql://operator:password@127.0.0.1:5432/saas_admin
ADMIN_ENABLE_OPERATOR=true
ADMIN_ALLOWED_APP_ORIGINS=https://reports.apps.internal
ADMIN_APP_DNS_SUFFIXES=apps.internal
ADMIN_UI_ORIGIN=https://admin.example.com
ADMIN_UI_OIDC_ISSUER=https://identity.example.com/realms/platform
ADMIN_UI_OIDC_CLIENT_ID=saas-admin-console
ADMIN_UI_OIDC_CLIENT_SECRET=
# Exact stable Keycloak sub values, comma-separated. No email/tenant-role based access.
ADMIN_UI_ALLOWED_SUBJECTS=
# Random 32 bytes, base64 encoded; same key on every console replica.
ADMIN_UI_SESSION_KEY=
# Loopback-only HTTP for local development, never remote/production.
ADMIN_UI_ALLOW_LOCAL_HTTP=false
ADMIN_ALLOW_LOCAL_HTTP=false
